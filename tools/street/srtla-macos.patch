diff --git a/macos_compat.h b/macos_compat.h
new file mode 100644
index 0000000..b0375fa
--- /dev/null
+++ b/macos_compat.h
@@ -0,0 +1,39 @@
+/*
+    macOS portability shim for srtla (footnote street rig, P7-D / R45).
+    Upstream is Linux-only; the README notes porting to other *nix is
+    expected to be straightforward. This header supplies:
+      - glibc <endian.h> byte-order macros via libkern/OSByteOrder.h
+      - O_NONBLOCK plumbing (SOCK_NONBLOCK does not exist on macOS;
+        callers use a fcntl() fallback guarded by __APPLE__)
+    epoll is provided separately by epoll-shim (kqueue-backed), pulled in
+    through the include path so <sys/epoll.h> resolves unmodified.
+*/
+#ifndef MACOS_COMPAT_H
+#define MACOS_COMPAT_H
+
+#ifdef __APPLE__
+#include <libkern/OSByteOrder.h>
+#include <fcntl.h>
+#include <time.h>
+
+/* Linux's coarse (low-res, cheap) monotonic clock; plain CLOCK_MONOTONIC
+   is the closest portable equivalent — strictly more precise, never wrong. */
+#ifndef CLOCK_MONOTONIC_COARSE
+#define CLOCK_MONOTONIC_COARSE CLOCK_MONOTONIC
+#endif
+
+#ifndef htobe16
+#define htobe16(x) OSSwapHostToBigInt16(x)
+#endif
+#ifndef htobe32
+#define htobe32(x) OSSwapHostToBigInt32(x)
+#endif
+#ifndef be16toh
+#define be16toh(x) OSSwapBigToHostInt16(x)
+#endif
+#ifndef be32toh
+#define be32toh(x) OSSwapBigToHostInt32(x)
+#endif
+
+#endif /* __APPLE__ */
+#endif /* MACOS_COMPAT_H */
