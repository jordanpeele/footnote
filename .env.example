# Footnote — server-side keys (Vercel env vars, or .env.local for `vercel dev`).
# Nothing here ever reaches the browser.

# Claim extraction (stage 1) — Claude Haiku pulls the checkable claim from speech
ANTHROPIC_API_KEY=

# Claim verification (stage 2) — Perplexity sonar-pro checks it against high-trust sources
PERPLEXITY_API_KEY=

# Speech-to-text. Must be a GRANT-CAPABLE key (Member scope) so /api/dg-token can mint
# short-lived browser tokens. A plain transcription-only key works for the chunked
# /api/transcribe fallback but not for low-latency streaming.
DEEPGRAM_API_KEY=

# State channel + rate limiting — any Upstash Redis REST credentials.
# (On Vercel, installing Upstash via the Marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN
# automatically; the UPSTASH_* names work too.)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Hosted deployment spend controls. Set this to 1 on Vercel; leave unset for self-hosting.
HOSTED_MODE=

# --- Local self-host (`npm start` / docker compose up) ---------------------------------
# The single-process server (src/server/) loads .env and .env.local itself (.env.local
# wins; real environment variables win over both). Redis is NOT needed locally: the state
# channel defaults to the in-process memory adapter (FOOTNOTE_STATE=memory), and rate
# limiting simply fails open without Upstash credentials. Optional overrides:
#   PORT=3000              # listen port
#   HOST=127.0.0.1         # bind address (docker-compose sets 0.0.0.0)
#   FOOTNOTE_STATE=upstash # force the Redis state channel locally
